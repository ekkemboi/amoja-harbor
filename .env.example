# Copy to .env and fill in. `neon env pull --file .env` writes these for you.
#
# Direct connection: used by the Flask/gunicorn process, which keeps its own pool.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Pooled connection: used by short-lived/serverless callers.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Set to 1 to log every SQL statement.
SQLALCHEMY_ECHO=0
