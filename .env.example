# Copy to .env and adjust. Real environment variables override these values.
#
# SQLite is the default. A relative path is resolved from the repository root;
# `instance/` is gitignored.
DATABASE_URL=sqlite:///instance/amoja_harbor.db

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Set to 1 to log every SQL statement.
SQLALCHEMY_ECHO=0

# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0

# Optional override for the test suite. Defaults to a throwaway file under pytest's
# tmp directory, so tests never touch the development database.
#TEST_DATABASE_URL=sqlite:///instance/amoja_harbor_test.db
